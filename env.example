# Required: Neo4j Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Required: Ollama Local Configuration (Query Agent, Graph Builder)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_API_KEY=  # Only needed if local Ollama requires auth
OLLAMA_NUM_GPU=99
OLLAMA_KEEP_ALIVE=24h
OLLAMA_REQUEST_TIMEOUT_SEC=120

# Query Agent LLM Routing (intent + Cypher stage)
# QUERY_USE_CLOUD=true enables cloud for query stage only.
# QUERY_PARALLEL_LLM=true runs local+cloud in parallel race mode.
QUERY_USE_CLOUD=false
QUERY_PARALLEL_LLM=false
QUERY_PARALLEL_TIMEOUT_SEC=10
QUERY_INTENT_MAX_TOKENS=200
QUERY_CYPHER_MAX_TOKENS=320
QUERY_INTENT_TIMEOUT_SEC=8
QUERY_CYPHER_TIMEOUT_SEC=12
QUERY_ENABLE_WARMUP=true
QUERY_WARMUP_TIMEOUT_SEC=20

# Ollama Cloud Configuration (Context Builder, Explanation Agent)
OLLAMA_CLOUD_URL=https://api.ollama.com/v1
OLLAMA_CLOUD_MODEL=minimax-m2.7:cloud
OLLAMA_CLOUD_API_KEY=your_cloud_api_key_here

# Required: Embedding Model for vector search
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Ingestion extraction tuning (chunking + stronger relation pass)
INGESTION_MIN_CHUNKING_CHARS=2500
INGESTION_CHUNK_SIZE_CHARS=2200
INGESTION_CHUNK_OVERLAP_CHARS=220
INGESTION_CHUNK_PARALLELISM=4
INGESTION_RELATION_GLOBAL_PASS=true

# Required: ChromaDB Storage
CHROMADB_PATH=./data/chromadb

# Optional: API Authentication (for OpenWebUI)
# Leave blank for local development without auth
API_KEY=

# Optional: Model name exposed to OpenWebUI
MODEL_NAME=grag-pipeline-v1

# Optional: Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Optional: Cloud LLM (for Context Builder / Explanation Agents)
# Leave blank to use Ollama only
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: Context Management
CONTEXT_TOKEN_BUDGET=8192
CONTEXT_WARNING_THRESHOLD=0.80

# Optional: Retrieval Configuration
RETRIEVAL_SIMILARITY_THRESHOLD=0.75
RETRIEVAL_TOP_K=20
RETRIEVAL_MAX_HOPS=4
