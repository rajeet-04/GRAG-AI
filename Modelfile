# Base the new model on requested Qwen 3.5 4B build

FROM qwen3.5:4b

# Keep context practical for low-latency graph reasoning

PARAMETER num_ctx 4096

# FORCE GPU: Tells Ollama to attempt to offload all layers to the GPU

PARAMETER num_gpu 99

# SYSTEM OVERHEAD: Ensures memory-mapped files are used for faster loading

PARAMETER use_mmap true

# OPTIONAL: You can add your own system prompt for your GRAG AI project here

SYSTEM "You are a highly efficient AI assistant optimized for RAG and Graph-based data retrieval."
